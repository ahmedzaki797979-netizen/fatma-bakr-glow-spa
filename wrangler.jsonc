{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fatma-bakr-glow-spa",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-16",
 "assets": {
  "directory": "./assets",
  "run_worker_first": true
},
  "kv_namespaces": [
    {
      "binding": "SPA_KV",
      "id": "c4687e109f3846baa1035ccf3326508d"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  }
}
